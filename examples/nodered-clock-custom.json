        "z": "796765267b92cb73",
        "name": "Build Manifest",
        "func": "// Build the display manifest. Drawing only: time comes from msg.clock, colours from msg.theme.\nconst sprites = flow.get(\"sprites-14-21-2\");\n\nif (!sprites) {\n  throw new Error('Flow context \"sprites-14-21\" is empty. Has the startup lane run (redeploy)?');\n}\n\nconst { HH, MM } = msg.clock;\nconst { background, foreground1, foreground2 } = msg.theme;\n\nconst SPRITE_WIDTH = 14; // columns per digit sprite; each sprite is 14 x 21\n\n// Digit positions in matrix pixels (top-left corner of each sprite).\n// Hours sit on the upper row, minutes on the lower row, offset to the right.\nconst DIGITS = [\n  { char: HH[0], posX: 7, posY: 9 },\n  { char: HH[1], posX: 25, posY: 9 },\n  { char: MM[0], posX: 25, posY: 34 },\n  { char: MM[1], posX: 43, posY: 34 },\n];\n\nconst drawings = DIGITS.map(({ char, posX, posY }) => {\n  const content = sprites[char];\n\n  if (!content) {\n    throw new Error(`No sprite for digit \"${char}\"`);\n  }\n\n  return {\n    type: \"block\",\n    posX,\n    posY,\n    scale: 1,\n    width: SPRITE_WIDTH,\n    palette: { 1: foreground1, 2: foreground2 },\n    content,\n  };\n});\n\nmsg.payload = {\n  meta: {\n    width: 64,\n    height: 64,\n    background,\n    cacheLifespan: 5000, // ms the client may cache this manifest\n  },\n  slides: [\n    {\n      duration: 3000, // ms\n      drawings,\n    },\n  ],\n};\n\nreturn msg;",
