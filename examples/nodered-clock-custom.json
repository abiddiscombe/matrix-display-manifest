    {
        "id": "09ca5563b2a0552e",
        "type": "function",
        "z": "796765267b92cb73",
        "name": "Read Local Time",
        "func": "// Resolve the current wall-clock time in the configured time zone.\n// Output: msg.clock = { timeZone, HH, MM, hour }  (HH / MM are zero-padded strings)\nconst DEFAULT_TIME_ZONE = \"Europe/London\";\n\n// Tab environment variable (double-click the tab > Environment Variables).\nconst timeZone = env.get(\"TIME_ZONE\") || DEFAULT_TIME_ZONE;\n\nlet formatter;\ntry {\n  formatter = new Intl.DateTimeFormat(\"en-GB\", {\n    timeZone,\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    hourCycle: \"h23\", // 00-23, so midnight is \"00\" rather than \"24\"\n  });\n} catch (err) {\n  // Intl throws a RangeError for unknown zone names.\n  throw new Error(`TIME_ZONE \"${timeZone}\" is not a valid IANA zone name (e.g. \"Europe/London\")`);\n}\n\nconst parts = formatter.formatToParts(new Date());\nconst HH = parts.find((p) => p.type === \"hour\").value;\nconst MM = parts.find((p) => p.type === \"minute\").value;\n\nmsg.clock = { timeZone, HH, MM, hour: Number(HH) };\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 240,
        "wires": [
            [
                "9dc9bd602ac270aa"
            ]
        ],
        "info": "Reads the current time in the `TIME_ZONE` tab variable (default `Europe/London`) and sets `msg.clock`.\n\nThrows if the zone name is not a valid IANA name."
    },
    {
        "id": "9dc9bd602ac270aa",
        "type": "function",
        "z": "796765267b92cb73",
        "name": "Select Theme",
        "func": "// Pick the colour theme for the current hour.\n// Input:  msg.clock.hour (0-23)\n// Output: msg.theme = { name, start, background, foreground1, foreground2 }\n//\n// Each theme applies from its `start` hour (inclusive) until the next theme starts.\n// Keep this list sorted by `start` and make sure one entry starts at 0.\n// Colours are CSS hex; the 8-digit form is #RRGGBBAA.\n\nconst THEMES = [\n  {\n    name: \"night\",\n    start: 0,\n    background: \"#000000\",\n    foreground1: \"#040404ff\",\n    foreground2: \"#550000ff\",\n  },\n  {\n    name: \"morning\",\n    start: 6,\n    background: \"#000000\",\n    foreground1: \"#040404ff\",\n    foreground2: \"#6e2300ff\",\n  },\n  {\n    name: \"noon\",\n    start: 13,\n    background: \"#000000\",\n    foreground1: \"#040404ff\",\n    foreground2: \"#77002eff\",\n  },\n  {\n    name: \"evening\",\n    start: 18,\n    background: \"#000000\",\n    foreground1: \"#040404ff\",\n    foreground2: \"#550000ff\",\n  },\n];\n\nconst { hour } = msg.clock;\n\n// Last theme whose start hour has been reached.\nconst theme = [...THEMES].reverse().find(({ start }) => hour >= start);\n\nif (!theme) {\n  throw new Error(`No theme matches hour \"${hour}\"`);\n}\n\nmsg.theme = theme;\n\nreturn msg;",
